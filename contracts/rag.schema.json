      "type": "object"
    },
    "RagRequest": {
      "additionalProperties": false,
      "properties": {
        "relationship_status": {
          "anyOf": [
            {
              "enum": [
                "general",
                "single",
                "dating",
                "married"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relationship Status"
        },
        "top_k": {
          "default": 3,
          "maximum": 10,
          "minimum": 1,
          "title": "Top K",
          "type": "integer"
        },
        "threshold": {
          "default": 0.25,
          "maximum": 1,
          "minimum": 0,
          "title": "Threshold",
          "type": "number"
        },
        "message": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "scenario": {
          "default": "normal",
          "enum": [
            "normal",
            "slow",
            "rate_limit",
            "quota",
            "timeout",
            "dependency_failure"
          ],
          "title": "Scenario",
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "title": "RagRequest",
      "type": "object"
