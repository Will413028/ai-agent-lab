          "format": "uuid",
          "title": "Document Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "relationship_status": {
          "enum": [
            "general",
            "single",
            "dating",
            "married"
          ],
          "title": "Relationship Status",
          "type": "string"
